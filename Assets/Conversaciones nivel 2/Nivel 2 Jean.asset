    characterImagePosition2: {x: 0, y: 0}
    characterImageSize2: {x: 0, y: 0}
    showImage3: 0
    characterImage3: {fileID: 0}
    imagePosition3: 0
    characterImagePosition3: {x: 0, y: 0}
    characterImageSize3: {x: 0, y: 0}
    newBackground: {fileID: 0}
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 1
    sfxClip: {fileID: 8300000, guid: 49cb338487768634fa5ec69c72df78d6, type: 3}
    sfxDuration: 5
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    choices: []
    objetoAActivar: {fileID: 0}
    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "El aire se sent\xEDa denso y pesado, el olor a humo se filtraba a mis
      fosas nasales."
    panelType: 2
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 1
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImagePosition: {x: 0, y: 0}
    characterImageSize: {x: 0, y: 0}
    showImage2: 0
    characterImage2: {fileID: 0}
    imagePosition2: 0
    characterImagePosition2: {x: 0, y: 0}
    characterImageSize2: {x: 0, y: 0}
    showImage3: 0
    characterImage3: {fileID: 0}
    imagePosition3: 0
    characterImagePosition3: {x: 0, y: 0}
    characterImageSize3: {x: 0, y: 0}
    newBackground: {fileID: 0}
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 1
    sfxClip: {fileID: 8300000, guid: 0b6ce84d814b61548a729a545282dedf, type: 3}
    sfxDuration: 3
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    choices: []
    objetoAActivar: {fileID: 0}
    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "Miles de personas se apretaban contra la puerta de la Bastille Saint-Antoine,
      seg\xFAn Elodie"
    panelType: 2
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 1
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImagePosition: {x: 0, y: 0}
    characterImageSize: {x: 0, y: 0}
    showImage2: 0
    characterImage2: {fileID: 0}
    imagePosition2: 0
    characterImagePosition2: {x: 0, y: 0}
    characterImageSize2: {x: 0, y: 0}
    showImage3: 0
    characterImage3: {fileID: 0}
    imagePosition3: 0
    characterImagePosition3: {x: 0, y: 0}
    characterImageSize3: {x: 0, y: 0}
    newBackground: {fileID: 0}
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    choices: []
    objetoAActivar: {fileID: 0}
    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "seg\xFAn Elodie, un s\xEDmbolo del absolutismo que gobernaba en aquella
      \xE9poca, y el mayor dispositivo de p\xF3lvora del pa\xEDs."
    panelType: 2
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 1
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImagePosition: {x: 0, y: 0}
    characterImageSize: {x: 0, y: 0}
    showImage2: 0
    characterImage2: {fileID: 0}
    imagePosition2: 0
    characterImagePosition2: {x: 0, y: 0}
    characterImageSize2: {x: 0, y: 0}
    showImage3: 0
    characterImage3: {fileID: 0}
    imagePosition3: 0
    characterImagePosition3: {x: 0, y: 0}
    characterImageSize3: {x: 0, y: 0}
    newBackground: {fileID: 0}
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 1
    sfxClip: {fileID: 8300000, guid: 0b6ce84d814b61548a729a545282dedf, type: 3}
    sfxDuration: 3
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    choices: []
    objetoAActivar: {fileID: 0}
    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "El lugar era una masacre. Hab\xEDa m\xFAltiples cad\xE1veres esparcidos
      por el suelo, al menos cien revolucionarios\u2026 una enorme cantidad a diferencia
      de los guardias."
    panelType: 2
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 1
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImagePosition: {x: 0, y: 0}
    characterImageSize: {x: 0, y: 0}
    showImage2: 0
    characterImage2: {fileID: 0}
    imagePosition2: 0
    characterImagePosition2: {x: 0, y: 0}
    characterImageSize2: {x: 0, y: 0}
    showImage3: 0
    characterImage3: {fileID: 0}
    imagePosition3: 0
    characterImagePosition3: {x: 0, y: 0}
    characterImageSize3: {x: 0, y: 0}
    newBackground: {fileID: 0}
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 1
    sfxClip: {fileID: 8300000, guid: b492623569eb59b4488b9d1be905e496, type: 3}
    sfxDuration: 3
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    choices: []
    objetoAActivar: {fileID: 0}
    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: Entre el humo denso de las primeras descargas de mosquete, divisamos a
      Jean y a Jules en la vanguardia, representando dos caminos irreconciliables
      frente al mismo abismo.
    panelType: 2
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 1
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImagePosition: {x: 0, y: 0}
    characterImageSize: {x: 0, y: 0}
    showImage2: 0
