    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "Tras el asalto al Palacio de las Tuller\xEDas, el Rey Luis XVI no pose\xEDa
      ning\xFAn poder real."
    panelType: 1
    choicePanelType: 0
