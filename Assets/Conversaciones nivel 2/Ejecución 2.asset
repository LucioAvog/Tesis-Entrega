    characterImageSize3: {x: 0, y: 0}
    newBackground: {fileID: 0}
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    choices: []
    objetoAActivar: {fileID: 0}
    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "Jean y yo permanec\xEDamos en la primera fila,  custodiados por el guardia
      nacional. El carruaje que transportaba al pasado Rey se detuvo."
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 0
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImagePosition: {x: 0, y: 0}
    characterImageSize: {x: 0, y: 0}
    showImage2: 0
