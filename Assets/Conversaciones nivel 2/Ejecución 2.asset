    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    choices: []
    objetoAActivar: {fileID: 0}
    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: Cientos de personas ocupaban el lugar en un silencio sofocante.
    panelType: 2
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 0
    showImage: 0
