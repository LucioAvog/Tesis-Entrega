    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "Avanc\xE9 hacia el centro del recinto con un documento en las manos. A
      pocos metros, Jules me observaba con una expresi\xF3n indescifrable. "
    panelType: 2
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 0
    showImage: 0
