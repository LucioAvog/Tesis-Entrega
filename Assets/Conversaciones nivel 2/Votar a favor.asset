  m_Name: Votar a favor
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  conversationLines:
  - speaker: 
    text: "Me desprend\xED de la sombra de la columna y avanc\xE9 lentamente hacia
      los escalones de la tribuna. Sent\xEDa cientos de miradas clavadas en mi espalda:
      el pueblo en la galer\xEDa, los girondinos en las gradas\u2026 y Jean, en lo
      m\xE1s alto, con los labios entreabiertos."
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 0
