    shakeDuration: 0.4
    shakeIntensity: 4
    playSound: 1
    soundClip: {fileID: 8300000, guid: fd8dced5c1745ab4fa4203825aa83b89, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Les grit\xE9, provocando que me mirara. \r\n"
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Mi arrepentimiento fue instant\xE1neo, al observar que la espada del guardia
      segu\xEDa en sus manos. Sin embargo, no fui degollado. \xC9l me observ\xF3
      un momento, murmur\xF3 algo a su compa\xF1ero y se alej\xF3."
    showImage: 1
    characterImage: {fileID: -6908545255849982002, guid: eeb8d35e726ff2647ba93e332e34e804, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Tal vez me recuerden en un futuro\u2026 tragu\xE9 saliva con fuerza, la
      idea me aferraba. No era un hombre muy valiente para esto\u2026 \r\n"
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
