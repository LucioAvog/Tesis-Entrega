  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  conversationLines:
  - speaker: 
    text: "Apenas hab\xEDan pasado unas cuantas horas desde nuestro arresto, pero
      dentro de los calabozos de La Conciergerie el tiempo parec\xEDa haberse detenido."
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
