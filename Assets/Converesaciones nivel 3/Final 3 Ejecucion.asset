    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "Afuera, a trav\xE9s de los barrotes de la alta ventana, el cielo de Par\xEDs
      se te\xF1\xEDa de un gris plomizo."
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 1
    mostrarImagenPantalla: 0
