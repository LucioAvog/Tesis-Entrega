  - speaker: 
    text: "Jules a su lado pareci\xF3 mirarlo con algo parecido al desprecio, claramente
      disgustado."
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
