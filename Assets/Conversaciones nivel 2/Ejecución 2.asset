  - speaker: 
    text: "El d\xEDa de la ejecuci\xF3n hab\xEDa llegado. La neblina en la plaza
      era tan densa que apenas pod\xEDa ver la silueta de la guillotina.\r\n"
    panelType: 2
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 0
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImagePosition: {x: 0, y: 0}
    characterImageSize: {x: 0, y: 0}
    showImage2: 0
    characterImage2: {fileID: 0}
    imagePosition2: 0
    characterImagePosition2: {x: 0, y: 0}
    characterImageSize2: {x: 0, y: 0}
    showImage3: 0
