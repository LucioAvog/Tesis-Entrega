  m_Script: {fileID: 11500000, guid: 8adeb66ea48d6884c9ae1c35b5ca9e1a, type: 3}
  m_Name: Negarse
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  defaultPanelType: 0
  nextConversation: {fileID: 0}
  changeSceneOnEnd: 1
  sceneToLoadOnEnd: Pueblo de Noche
  conversationLines:
  - speaker: Francois
    text: "No, \xBFacaso quieres terminar colgada en la plaza? \xBFo ser encarcelada?"
    showImage: 1
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: fd8dced5c1745ab4fa4203825aa83b89, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Elodie
    text: "Fran\xE7ois, ambos sabremos que ir\xE9 sola aunque no me acompa\xF1es"
    showImage: 1
    characterImage: {fileID: -279528177590649484, guid: a43165c25c2222c4f916d608d276ce9e, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: b86074ec92355cd4d81fd67ee9c6fb62, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Una sonrisa juguetona sali\xF3 de sus labios\u2026 desafiandome."
    showImage: 1
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Maldita sea, era d\xE9bil ante estos chantajes.\r\n"
    showImage: 1
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Francois
    text: "\xA1Bien, bien! Te acompa\xF1ar\xE9.\r\n"
    showImage: 1
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: fd8dced5c1745ab4fa4203825aa83b89, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Mi voz sali\xF3 resignada.\r\n"
    showImage: 1
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Elodie
    text: "Elodie me abraz\xF3 con una sonrisa enorme, no pod\xEDa realmente decirle
      que no."
    showImage: 1
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
