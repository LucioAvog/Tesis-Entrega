  conversationLines:
  - speaker: Francois
    text: "\xBF\xA1Qu\xE9 les sucede!? \xA1D\xE9jenlo en paz, es inocente!\r\n"
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
