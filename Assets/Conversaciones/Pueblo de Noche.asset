    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "Adentro hab\xEDa m\xE1s personas de lo que esperaba, campesinos, herreros,
      mujeres con ni\xF1os en brazos, y m\xE1s comerciantes de lo que imagin\xE9.\r\n"
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 1
    mostrarImagenPantalla: 0
    imagenPantalla: {fileID: 0}
    posicionImagenPantalla: {x: 0, y: 0}
