  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8adeb66ea48d6884c9ae1c35b5ca9e1a, type: 3}
  m_Name: Union 2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  defaultPanelType: 0
  nextConversation: {fileID: 0}
  changeSceneOnEnd: 0
  sceneToLoadOnEnd: 
  conversationLines:
  - speaker: Elodie
    text: "\xA1Malditos bastardos! Se\xF1or, se\xF1ora, \xBFse encuentran bien? \r\n"
    showImage: 1
    characterImage: {fileID: 5184651387025587248, guid: a0e2fdf87989cc049932ed6f5604fc02, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: b86074ec92355cd4d81fd67ee9c6fb62, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Elodie se acerc\xF3 r\xE1pidamente a ellos, mientras yo la segu\xEDa por
      atr\xE1s. \r\n"
    showImage: 1
    characterImage: {fileID: -1087421258012235777, guid: c2d09e26aef54fc4884531ebf704c0fd, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 1
    choices: []
  - speaker: Vecino
    text: "S\xED\u2026 gracias por eso. No quer\xEDa robar, lo juro. Pero mi sueldo
      se va a los impuestos, no alcanza el dinero para darle comida a mis ni\xF1os."
    showImage: 1
    characterImage: {fileID: 1327967010630095347, guid: 7562b8334a1cd7e45b36b0d3434b10fd, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: 6f67ade3026f3c54e9ee369e6bbf3c8f, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Dijo el hombre empezando a levantarse, mientras su esposa le ofrec\xEDa
      un pa\xF1uelo para limpiarse la sangre.\r\n"
    showImage: 1
    characterImage: {fileID: -279528177590649484, guid: a43165c25c2222c4f916d608d276ce9e, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 1
    choices: []
  - speaker: Vecina
    text: "Escuch\xE9 que hay problemas en la plaza principal por esto mismo.\r\n"
    showImage: 1
    characterImage: {fileID: -371421024749649275, guid: 41a21f1bb2e4a6041bd44b12409add92, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: 37c6e533efafb7d4d95bd1c260f45f3f, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Murmur\xF3 aquella se\xF1ora preocupada."
    showImage: 0
    characterImage: {fileID: -279528177590649484, guid: a43165c25c2222c4f916d608d276ce9e, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 1
    choices: []
  - speaker: Francois
    text: "\xBFProblemas? \xBFQu\xE9 clases de problemas?\r\n"
    showImage: 0
    characterImage: {fileID: -8894258904770162708, guid: 6d753f0340af57948a2878db80eb22eb, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: fd8dced5c1745ab4fa4203825aa83b89, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Pregunt\xE9 curioso.\r\n\r\n"
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 1
    choices: []
  - speaker: Vecino
    text: "Hay\u2026 bueno, los revolucionarios quieren derrocar la monarqu\xEDa."
    showImage: 1
    characterImage: {fileID: 3651360570310532851, guid: 10f1667fe3eff034a9f75c2e7ed33afe, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: 6f67ade3026f3c54e9ee369e6bbf3c8f, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: 'Dijo el hombre en un susurro.

'
    showImage: 0
    characterImage: {fileID: -279528177590649484, guid: a43165c25c2222c4f916d608d276ce9e, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 1
    choices: []
  - speaker: 
    text: "Eso solo provoc\xF3 que Elodie tuviera una sonrisa orgullosa. La idea
      de que un levantamiento ocurriera parec\xEDa entusiasmarla. No s\xE9 si pod\xEDa
      decir lo mismo.\r\n"
    showImage: 1
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Vecina
    text: "\xBFEstar\xEDan interesados en eso? "
    showImage: 1
    characterImage: {fileID: -371421024749649275, guid: 41a21f1bb2e4a6041bd44b12409add92, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: 37c6e533efafb7d4d95bd1c260f45f3f, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Pregunt\xF3 la mujer, algo curiosa."
    showImage: 0
    characterImage: {fileID: -279528177590649484, guid: a43165c25c2222c4f916d608d276ce9e, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 1
    choices: []
  - speaker: Elodie
    text: "\xA1Por supuesto! Me parece una idea muy acertada \r\n"
    showImage: 1
    characterImage: {fileID: -279528177590649484, guid: a43165c25c2222c4f916d608d276ce9e, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: b86074ec92355cd4d81fd67ee9c6fb62, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "El se\xF1or pareci\xF3 suspirar, apretando a\xFAn m\xE1s su pa\xF1uelo
      para evitar que la sangre siguiera saliendo. Con una expresi\xF3n rendida,
      habl\xF3:"
    showImage: 1
    characterImage: {fileID: 1327967010630095347, guid: 7562b8334a1cd7e45b36b0d3434b10fd, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Vecino
    text: "\xBFSaben? Creo que ustedes deber\xEDan saberlo. Hay una reuni\xF3n en
      la plaza esta noche. Tres j\xF3venes involucrados son los organizadores de
      esto. Uno de ellos representa al pueblo, otro a la revoluci\xF3n y el \xFAltimo
      a la burgues\xEDa."
    showImage: 1
    characterImage: {fileID: 3651360570310532851, guid: 10f1667fe3eff034a9f75c2e7ed33afe, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: 6f67ade3026f3c54e9ee369e6bbf3c8f, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Elodie
    text: "No tienen todos las mismas ideas? \xBFPor qu\xE9 los menciona por separado?
      \r\n"
    showImage: 1
    characterImage: {fileID: -279528177590649484, guid: a43165c25c2222c4f916d608d276ce9e, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: b86074ec92355cd4d81fd67ee9c6fb62, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Lade\xF3 Elodie, girando la cabeza de manera curiosa.\r\n\r\n"
    showImage: 0
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 1
    choices: []
  - speaker: Vecino
    text: "No\u2026 eh, creanme que no. Ya los conocer\xE1n si deciden ir, son los
      tres muy\u2026 opuestos "
    showImage: 1
    characterImage: {fileID: 1327967010630095347, guid: 7562b8334a1cd7e45b36b0d3434b10fd, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: 6f67ade3026f3c54e9ee369e6bbf3c8f, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "la mujer llev\xF3 a su esposo dentro de su casa, despidi\xE9ndonos con
      un asentamiento."
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Elodie
    text: "\xA1Tenemos que ir! \r\n"
    showImage: 1
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 1
    shakeDuration: 0.25
    shakeIntensity: 5
    playSound: 1
    soundClip: {fileID: 8300000, guid: b86074ec92355cd4d81fd67ee9c6fb62, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Francois
    text: 'Elodie, no insistas, es peligroso.

'
    showImage: 1
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 1
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: fd8dced5c1745ab4fa4203825aa83b89, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Elodie
    text: "Fran\xE7ois, esto es una oportunidad de oro. \xBFCu\xE1ndo podremos ir
      a verlo de primera mano? Somos simples pueblerinos, esto suena bien\u2026 anda,
      \xBFque dices?\r\n"
    showImage: 1
    characterImage: {fileID: -279528177590649484, guid: a43165c25c2222c4f916d608d276ce9e, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: b86074ec92355cd4d81fd67ee9c6fb62, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices:
    - buttonText: Aceptar
      nextDialogue: {fileID: 11400000, guid: 114864907e17d7c4e90e1919764c3584, type: 2}
      buttonBackground: {fileID: 3364988206025089807, guid: 838328866da142743a820ec1cd07e6ac, type: 3}
      changeScene: 0
