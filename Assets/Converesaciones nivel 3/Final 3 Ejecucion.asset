    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "En la celda contigua, separada por una gruesa reja de hierro oxidado,
      Jules permanec\xEDa sentado sobre una pila de paja seca."
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 1
