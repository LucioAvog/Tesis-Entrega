    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "Unirme a Jean signific\xF3 dejar atr\xE1s mi vida en el campo, reemplazando
      cosechas por reuniones en la Convenci\xF3n Nacional. Elodie y yo logramos ascender
      bajo la gu\xEDa de Jean Dubois, cuya influencia pol\xEDtica crec\xEDa junto
      a la ira del pueblo."
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 0
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImagePosition: {x: 0, y: 0}
    characterImageSize: {x: 0, y: 0}
    showImage2: 0
