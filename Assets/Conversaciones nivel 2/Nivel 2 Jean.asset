    imagePosition2: 0
    characterImagePosition2: {x: 0, y: 0}
    characterImageSize2: {x: 0, y: 0}
    showImage3: 0
    characterImage3: {fileID: 0}
    imagePosition3: 0
    characterImagePosition3: {x: 0, y: 0}
    characterImageSize3: {x: 0, y: 0}
    newBackground: {fileID: 0}
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 1
    sfxClip: {fileID: 8300000, guid: 0b6ce84d814b61548a729a545282dedf, type: 3}
    sfxDuration: 3
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    choices: []
    objetoAActivar: {fileID: 0}
    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "Jean ten\xEDa la camisa manchada de holl\xEDn y agitaba una pica con la
      cabeza de Jacques de Flesselles, la autoridad del lugar."
    panelType: 2
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 1
    showImage: 0
    characterImage: {fileID: 0}
