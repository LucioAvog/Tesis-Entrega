    shakeIntensity: 0
    choices: []
    objetoAActivar: {fileID: 0}
    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "Luis Capeto subi\xF3 los escalones con paso lento, casi parec\xEDa que
      quer\xEDa ganar tiempo. Intent\xF3 hablarle a la multitud, pero el redoble
      de tambores interrumpi\xF3 sus palabras."
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 0
