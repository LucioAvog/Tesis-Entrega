    characterImageSize2: {x: 0, y: 0}
    showImage3: 1
    characterImage3: {fileID: 2433035244665607080, guid: 48ccfea1a6bfbef488cf017275230f1d, type: 3}
    imagePosition3: 2
    characterImagePosition3: {x: 0, y: 0}
    characterImageSize3: {x: 0, y: 0}
    newBackground: {fileID: 0}
    playSound: 0
    soundClip: {fileID: 0}
