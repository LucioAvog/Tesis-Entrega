    objetoAActivar: {fileID: 0}
    objetoADesactivar: {fileID: 0}
    dispararCarruselPaneles: 0
  - speaker: 
    text: "Hab\xEDa un leve olor a humedad, vino barato, y humo de antorchas lejanas\u2026
      mientras que Elodie caminaba delante de m\xED, con rapidez mientras atravesamos
      callejones estrechos."
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 1
