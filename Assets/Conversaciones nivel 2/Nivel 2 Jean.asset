    dispararCarruselPaneles: 0
  - speaker: 
    text: "A diferencia de Jean, su ropa segu\xEDa igual de pulcra que siempre\u2026
      mejor dicho, manchado con peque\xF1as gotas de sangre gracias a la cabeza que
      el contrario sosten\xEDa."
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
