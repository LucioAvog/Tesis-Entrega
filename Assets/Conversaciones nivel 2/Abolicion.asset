    dispararCarruselPaneles: 0
  - speaker: 
    text: "Decir que el tiempo vol\xF3 ser\xEDa desestimarlo. 3 a\xF1os hab\xEDan
      pasado despu\xE9s de esa noche en la bodega. La situaci\xF3n no era la misma,
      nosotros tampoco."
    panelType: 1
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 0
    showImage: 0
    characterImage: {fileID: 0}
    imagePosition: 0
    characterImagePosition: {x: 0, y: 0}
    characterImageSize: {x: 0, y: 0}
    showImage2: 0
