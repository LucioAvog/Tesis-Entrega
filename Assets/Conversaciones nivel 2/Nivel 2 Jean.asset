  conversationLines:
  - speaker: 
    text: "ACTO 2:\nCa\xEDda de la Bastilla"
    panelType: 2
    choicePanelType: 0
    ocultarPanelDialogo: 0
    bloquearOtrosBotones: 0
    usarTransicionTexto: 0
    duracionTransicion: 1
    showImage: 0
