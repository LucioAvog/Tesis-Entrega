  m_Name: Puesto Madame Monique
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  defaultPanelType: 0
  nextConversation: {fileID: 0}
  changeSceneOnEnd: 1
  sceneToLoadOnEnd: Regreso al Pueblo
  conversationLines:
  - speaker: Madame Monique
    text: "Oh, \xA1Fran\xE7ois, Elodie! \xBFC\xF3mo se encuentran, ni\xF1os?\r\n"
    showImage: 1
    characterImage: {fileID: -7477236536988458850, guid: fcbad9ce4edab3c43a66df965428e321, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: 37c6e533efafb7d4d95bd1c260f45f3f, type: 3}
