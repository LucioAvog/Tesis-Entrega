    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: dijo alegremente.
    showImage: 1
    characterImage: {fileID: -7477236536988458850, guid: fcbad9ce4edab3c43a66df965428e321, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Elodie
    text: "\xA1Madame Monique! Que gusto verla, estamos muy bien. Vinimos por pan.\r\n"
    showImage: 1
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: b86074ec92355cd4d81fd67ee9c6fb62, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: Dijo Elodie antes de que yo hablara
    showImage: 1
    characterImage: {fileID: 749445152557612188, guid: 8626c246a03ffbf4da7e963b1bf26a69, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Madame Monique
    text: "Mis ni\xF1os, lamento decirles pero no he podido hacerlo. No podr\xE9
      seguir con mi negocio. El precio del trigo ha aumentado mucho, y las cosechas
      no mejoran.\r\n"
    showImage: 1
    characterImage: {fileID: 8443459525071470120, guid: 1fbbb3f58e5c22c43aa75387b190d837, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: 37c6e533efafb7d4d95bd1c260f45f3f, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "Al o\xEDr sus palabras, sent\xED una fuerte tensi\xF3n en mi pecho mientras
      mis hombros se tensaban. Esto era injusto.\r\n"
    showImage: 1
    characterImage: {fileID: 8443459525071470120, guid: 1fbbb3f58e5c22c43aa75387b190d837, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 1
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 0
    soundClip: {fileID: 0}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: Elodie
    text: "\xA1Pero-, Madame Monique! Eso es tan injusto para usted. No podemos seguir
      viviendo en esta miseria. \xA1Debemos actuar r\xE1pido! "
    showImage: 1
    characterImage: {fileID: -1087421258012235777, guid: c2d09e26aef54fc4884531ebf704c0fd, type: 3}
    imagePosition: 0
    characterImageSize: {x: 0, y: 0}
    mostrarImagenUI: 0
    imagenUI: {fileID: 0}
    panelType: 0
    newBackground: {fileID: 0}
    triggerShake: 0
    shakeDuration: 0
    shakeIntensity: 0
    playSound: 1
    soundClip: {fileID: 8300000, guid: b86074ec92355cd4d81fd67ee9c6fb62, type: 3}
    playSFX: 0
    sfxClip: {fileID: 0}
    sfxDuration: 0
    dispararCarruselPaneles: 0
    ocultarPanelDialogo: 0
    choicePanelType: 0
    choices: []
  - speaker: 
    text: "exclam\xF3 Elodie, con un tono preocupado.\r\n"
    showImage: 1
    characterImage: {fileID: -1087421258012235777, guid: c2d09e26aef54fc4884531ebf704c0fd, type: 3}
